# ===== Mitaxy environment =====
# Copy to .env and fill in. NEVER commit the real .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=212.47.72.184,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://212.47.72.184
SITE_URL=http://212.47.72.184
TIME_ZONE=Asia/Karachi

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://mitaxy:CHANGE_ME@127.0.0.1:5432/mitaxy

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://127.0.0.1:6379/5
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/6

# --- Recall.ai (meeting bot) ---
RECALL_API_KEY=
RECALL_REGION=us-east-1
RECALL_BOT_NAME=Mitaxy Notetaker

# --- Deepgram (transcription) ---
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# --- Groq (AI notes) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Resend (email) ---
RESEND_API_KEY=
RESEND_FROM=Mitaxy <onboarding@resend.dev>
